ARG PYTHON_TAG=3.13-builder
FROM registry.access.redhat.com/hi/python:${PYTHON_TAG}

WORKDIR /app
USER root

RUN dnf install -y git && dnf clean all

RUN pip install --no-cache-dir --upgrade pip

RUN pip install --no-cache-dir \
    "lightspeed-evaluation @ git+https://github.com/lightspeed-core/lightspeed-evaluation.git@d6194d57b1af8cfb6749fe4bad1f8156d3e9694c" \
    fastapi \
    "uvicorn[standard]" \
    httpx \
    pyyaml \
    psycopg2-binary \
    "msgpack==1.2.3" \
    "setuptools>=78.1.1"

# pip is not needed at runtime and its vendored deps (pip/_vendor/vendor.txt)
# ship known-vulnerable msgpack/setuptools/urllib3 that cannot be upgraded.
RUN pip uninstall -y pip

COPY src/ ./
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && \
    chown 65532:0 /app && chmod g+w /app

USER 65532

# /evals  — mounted from PVC: system.yaml + eval_*.yaml (agent-engine writes these)
# /eval_output — mount a volume here for result persistence
VOLUME ["/evals", "/eval_output"]

EXPOSE 8099

ENTRYPOINT ["/app/entrypoint.sh", "uvicorn", "eval_api:app", "--host", "0.0.0.0", "--port", "8099"]
