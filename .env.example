# Agent Server Configuration
AGENT_HOST=0.0.0.0
AGENT_PORT=5002
#AGENT_SSL_KEYFILE=/path_to/ssl_key.pem
#AGENT_SSL_CERTFILE=/path_to/ssl_cert.pem

# Python Logging
PYTHON_LOG_LEVEL=INFO

USE_INMEMORY_SAVER=true

# pgvector credentials for agentic memory (used when USE_INMEMORY_SAVER=false)
POSTGRES_USER=pgvector
POSTGRES_PASSWORD=pgvector
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=pgvector

# exception
LANGFUSE_SECRET_KEY=sk-lf-f46b492e-9335-
LANGFUSE_PUBLIC_KEY=pk-lf-dfa0dab0-c486-
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

#Google Vertex AI service creds
GOOGLE_APPLICATION_CREDENTIALS_CONTENT='{
    "type": "service_account",
    "project_id": "data-and-ai-gemini",
    ...
    ...
    ...
    "universe_domain": "googleapis.com"
  }'

# MCP config
MCP_SERVER_NAME=template-mcp-server
MCP_SERVER_URL=http://localhost:5001/mcp
MCP_TRANSPORT_PROTOCOL=streamable_http

# A2A Protocol Configuration
# Enables A2A endpoints (/.well-known/agent-card.json and /a2a)
A2A_ENABLED=true
# Agent Card identity (how this agent describes itself to other agents)
A2A_AGENT_NAME=Template Agent
A2A_AGENT_DESCRIPTION=A template AI agent with tool capabilities via MCP
A2A_AGENT_VERSION=1.0.0
# Agent Card provider — identifies who operates this agent (both required to appear in card)
#A2A_PROVIDER_ORG=Red Hat Data & AI
#A2A_PROVIDER_URL=https://github.com/redhat-data-and-ai/template-agent
# Comma-separated URLs of downstream A2A agents to delegate to (optional)
#A2A_DOWNSTREAM_AGENT_URLS=https://agent-a.example.com,https://agent-b.example.com
