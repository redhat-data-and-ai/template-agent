# ==============================================================================
# Environment Variables
#
# Only secrets and infrastructure endpoints belong here.
# All operational config (cache, middleware, filesystem, providers) lives in
# config/agent/runtime/agent.yaml — the single source of truth.
#
# OpenShift: secrets come via Secrets, infra via ConfigMaps.
# ==============================================================================

# --- SSO / OIDC Authentication ---
# Supports any OIDC-compliant provider (Keycloak, Okta, Azure AD, Auth0, etc.)
ENABLE_AUTH=false
SSO_ISSUER_URL=https://sso.example.com/realms/myrealm
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret
# SSO_JWKS_URI=https://sso.example.com/realms/myrealm/protocol/openid-connect/certs

# Dev fallback identity (used when ENABLE_AUTH=false)
SSO_DEV_USERNAME=John Doe
SSO_DEV_USER_ID=dev-user

# User ID encryption for observability privacy
ENABLE_USER_ID_ENCRYPTION=false
# USER_ID_ENCRYPTION_KEY=your-32-byte-hex-key

# --- Infrastructure ---

# Postgres (checkpoints, memory, feedback)
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=template_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (Aegra broker: SSE streaming, job queue, crash recovery)
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_ENABLED=true

# Open Policy Agent (trajectory policy checks via RegoTrajectoryMiddleware)
# Local dev: localhost. Compose stack: http://opa:8181/v1/data/agent/authz
OPA_URL=http://localhost:8181/v1/data/agent/authz
OPA_TIMEOUT=2.0
# Skip LLM in awrap_model_call and use this text (compliance override testing)
# COMPLIANCE_HARDCODED_MODEL_RESPONSE=BMI stands for Body Mass Index

# OPA Policy Git Repository (optional - leave empty to use local files)
# When set, git policies are loaded IN ADDITION to local policies in /policies
# See opa/GIT_POLICY_GUIDE.md for complete documentation
POLICY_GIT_REPO=
# Example: https://github.com/yourorg/opa-policies.git

# OPA Git Branch (default: main)
POLICY_GIT_BRANCH=main

# OPA Git Subdirectory (optional - uses sparse checkout for efficiency)
POLICY_GIT_SUBDIR=
# Example: policies/production

# OPA Git Authentication (ONLY for private repos - leave empty for public repos)
# GitHub: Personal Access Token with 'repo' scope
# GitLab: Personal Access Token with 'read_repository' scope
# Bitbucket: App password with 'repository:read' permission
# POLICY_GIT_AUTH_USER=yourname
# POLICY_GIT_AUTH_TOKEN=ghp_token123

# OPA Git SSL Verification (set to false for self-signed certificates, default: true)
# POLICY_GIT_SSL_VERIFY=false

# OPA Poll Interval (seconds between policy checks/updates, default: 2)
# POLL_INTERVAL=10

# --- Observability ---

# Langfuse (v4 SDK — auto-read by client and CallbackHandler)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# --- Model Provider Credentials ---

# Google Vertex AI
GOOGLE_APPLICATION_CREDENTIALS_CONTENT='{
    "type": "service_account",
    "project_id": "your-project-id",
    ...
    "universe_domain": "googleapis.com"
  }'

# vLLM / OpenAI-compatible (optional)
# VLLM_BASE_URL=http://vllm-server:8000/v1
# VLLM_API_KEY=EMPTY

# --- Runtime (rarely changed) ---

PYTHON_LOG_LEVEL=INFO
