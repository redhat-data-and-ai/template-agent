# Layers config/agent onto the agent image, for clusters with no config PVC.
#
# The base image deliberately ships no config (see Containerfile): in
# preprod/prod the operator mounts it, so baking it in would make a rebuild
# the only way to change a prompt. Kind has no such mount, and the agent
# refuses to start without PROMPT.md and mcp.json — so the local cluster
# gets a derived image instead of a second config-delivery mechanism.
#
#   podman build -t template-agent-config:local -f Containerfile.config .
#
# Nothing in deployment/overlays/openshift references this image.

ARG BASE=localhost/template-agent:local
FROM ${BASE}

COPY --chown=65532:root config/agent /app/config/agent
