{
    "mcpServers": {
        "dataverse-mcp": {
            "url": "https://mcp.dataverse.redhat.com/mcp/",
            "transport": "streamable_http",
            "enabled": true,
            "auth": true,
            "auth_mode": "dcr",
            "ssl_verify": true,
            "timeout": 120,
            "tool_prefix": "",
            "oauth": {
                "authorization_endpoint": "https://mcp.dataverse.redhat.com/auth/authorize",
                "token_endpoint": "https://mcp.dataverse.redhat.com/auth/token",
                "registration_endpoint": "https://mcp.dataverse.redhat.com/auth/register"
            }
        },
        "atlan-mcp": {
            "url": "https://redhat.atlan.com/mcp/api-key/",
            "transport": "streamable_http",
            "enabled": true,
            "auth": true,
            "auth_mode": "api_key",
            "auth_env_var": "ATLAN_MCP_API_KEY",
            "ssl_verify": true,
            "timeout": 60,
            "tool_prefix": ""
        },
        "pathfinder-mcp": {
            "url": "http://localhost:5003/mcp",
            "transport": "streamable_http",
            "enabled": true,
            "auth": false,
            "ssl_verify": false,
            "timeout": 60,
            "tool_prefix": ""
        }
    }
}
